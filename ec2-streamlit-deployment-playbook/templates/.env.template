# =============================================================================
# .env Template
# Copy this file to .env in your app directory and fill in real values.
#
# IMPORTANT SECURITY RULES:
#   - NEVER commit .env to GitHub
#   - Run: chmod 600 .env
#   - Add .env to .gitignore
#   - Use AWS Secrets Manager for production-grade secret management
#   - Rotate secrets regularly
# =============================================================================

# ---- Application Environment ----
# Set to "production" on EC2, "development" on your local machine
APP_ENV=production

# ---- AI / LLM API Keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=

# ---- Database ----
# Format examples:
#   PostgreSQL: postgresql://username:password@host:5432/database_name
#   MySQL:      mysql://username:password@host:3306/database_name
#   SQLite:     sqlite:///./app.db
DATABASE_URL=

# ---- AWS Configuration (if using boto3, S3, etc.) ----
# Note: On EC2, prefer IAM roles over access keys
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ---- Streamlit Server Settings ----
STREAMLIT_SERVER_PORT=8501

# ---- App-Specific Settings ----
# Add your application-specific variables below
# FEATURE_FLAG_NEW_UI=false
# MAX_UPLOAD_SIZE_MB=50
# LOG_LEVEL=INFO
