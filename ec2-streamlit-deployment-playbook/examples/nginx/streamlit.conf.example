# =============================================================================
# Nginx Reverse Proxy Configuration for Streamlit
# File: /etc/nginx/conf.d/streamlit.conf
#
# Copy this file to /etc/nginx/conf.d/streamlit.conf on your EC2 instance.
# Replace YOUR_DOMAIN_OR_IP with your actual domain or EC2 public IP.
#
# After placing the file:
#   sudo nginx -t
#   sudo systemctl reload nginx
# =============================================================================

server {
    listen 80;

    # Use server_name _ to match any hostname (IP or domain)
    # For production with a real domain, replace _ with your domain:
    # server_name app.yourcompany.com;
    server_name _;

    # Reverse proxy all traffic to Streamlit
    location / {
        proxy_pass http://127.0.0.1:8501;
        proxy_http_version 1.1;

        # Pass original headers to Streamlit
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for Streamlit WebSocket support
        # Without these headers, the Streamlit UI will not update in real time
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Long timeout — Streamlit sessions can be long-lived
        proxy_read_timeout 86400;
        proxy_connect_timeout 60;
        proxy_send_timeout 86400;
    }
}

